  (interestelar:Obra:Filme {id: 'interestelar', titulo: 'Interestelar', ano: 2014, duracao: 169, nota: 8.7}),
  (aChegada:Obra:Filme {id: 'aChegada', titulo: 'A Chegada', ano: 2016, duracao: 116, nota: 7.9}),
  (bladeRunner2049:Obra:Filme {id: 'bladeRunner2049', titulo: 'Blade Runner 2049', ano: 2017, duracao: 164, nota: 8.0}),
  (corra:Obra:Filme {id: 'corra', titulo: 'Corra!', ano: 2017, duracao: 104, nota: 7.8}),
  (freeSolo:Obra:Filme {id: 'freeSolo', titulo: 'Free Solo', ano: 2018, duracao: 100, nota: 8.1}),
  (parasita:Obra:Filme {id: 'parasita', titulo: 'Parasita', ano: 2019, duracao: 132, nota: 8.5}),
