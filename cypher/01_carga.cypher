  // ---------- Estúdios (Organizacao:Estudio, como Estudio ⊂ Organizacao) ----------
  (blumhouse:Organizacao:Estudio {id: 'blumhouse', nome: 'Blumhouse Productions', fundacao: 2000, pais: 'EUA'}),
