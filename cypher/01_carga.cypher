// =============================================================================
//  Cinéfilo: carga do grafo de propriedades no Memgraph
//  Mini-Projeto 4, Sistemas Baseados em Conhecimento (UFPB)
//
//  A mesma base do Mini-Projeto 3 (cinema.ttl), remodelada como grafo de
//  propriedades: nós com rótulos e propriedades, ligados por relacionamentos.
//  O script src/carregar.py apaga o banco, executa este arquivo e confere as
//  contagens. Cada comando termina em ';'.
// =============================================================================

// -----------------------------------------------------------------------------
//  Restrições de unicidade: o 'id' faz o papel das URIs do MP3
//  (cine:interestelar vira {id: 'interestelar'}) e não pode se repetir.
// -----------------------------------------------------------------------------
CREATE CONSTRAINT ON (f:Filme) ASSERT f.id IS UNIQUE;
CREATE CONSTRAINT ON (p:Pessoa) ASSERT p.id IS UNIQUE;
CREATE CONSTRAINT ON (e:Estudio) ASSERT e.id IS UNIQUE;
CREATE CONSTRAINT ON (r:Premio) ASSERT r.id IS UNIQUE;
CREATE CONSTRAINT ON (g:Genero) ASSERT g.id IS UNIQUE;

// -----------------------------------------------------------------------------
//  O grafo inteiro em um único CREATE: se algo falhar, nada é criado.
// -----------------------------------------------------------------------------
CREATE
  // ---------- Gêneros: a taxonomia de filmes do MP3 vira nós ----------
  // Ficcao e Documentario são as duas categorias; os demais são subgêneros de Ficcao.
  (Ficcao:Genero {id: 'Ficcao', nome: 'Ficção'}),
  (Documentario:Genero {id: 'Documentario', nome: 'Documentário'}),
  (FiccaoCientifica:Genero {id: 'FiccaoCientifica', nome: 'Ficção científica'}),
  (Drama:Genero {id: 'Drama', nome: 'Drama'}),
  (Acao:Genero {id: 'Acao', nome: 'Ação'}),
  (Terror:Genero {id: 'Terror', nome: 'Terror'}),
  (Animacao:Genero {id: 'Animacao', nome: 'Animação'}),
  // rdfs:subClassOf vira o relacionamento SUBGENERO_DE
  (FiccaoCientifica)-[:SUBGENERO_DE]->(Ficcao),
  (Drama)-[:SUBGENERO_DE]->(Ficcao),
  (Acao)-[:SUBGENERO_DE]->(Ficcao),
  (Terror)-[:SUBGENERO_DE]->(Ficcao),
  (Animacao)-[:SUBGENERO_DE]->(Ficcao),
  // owl:disjointWith: uma obra não pode ser ficção e documentário ao mesmo tempo
  (Ficcao)-[:DISJUNTO_DE]->(Documentario),
  // ---------- Filmes (rótulos Obra:Filme, como Filme ⊂ Obra no MP3) ----------
  (odisseia2001:Obra:Filme {id: 'odisseia2001', titulo: '2001: Uma Odisseia no Espaço', ano: 1968, duracao: 149, nota: 8.3}),
  (oIluminado:Obra:Filme {id: 'oIluminado', titulo: 'O Iluminado', ano: 1980, duracao: 146, nota: 8.4}),
  (toyStory:Obra:Filme {id: 'toyStory', titulo: 'Toy Story', ano: 1995, duracao: 81, nota: 8.3}),
  (toyStory2:Obra:Filme {id: 'toyStory2', titulo: 'Toy Story 2', ano: 1999, duracao: 92, nota: 7.9}),
  (meninaDeOuro:Obra:Filme {id: 'meninaDeOuro', titulo: 'Menina de Ouro', ano: 2004, duracao: 132, nota: 8.1}),
